# Скопируйте этот файл в .env и впишите свои значения. Файл .env в git не попадает.
# Все значения необязательны: без них программа запускается в демо-режиме.

# --- Режим работы ---
# 1 — демо: выдуманные объявления из demo_data.json, Авито и Telegram не используются (по умолчанию)
# 0 — реальный режим: сбор с Авито через Playwright (читайте дисклеймер в README)
DEMO=1

# --- Веб-дашборд ---
PORT=8000
# 127.0.0.1 — открыт только с этого компьютера. 0.0.0.0 — доступен всей сети (тогда обязательно задайте пароль)
HOST=127.0.0.1
# Пароль входа. Пусто: в демо — «demo», в реальном режиме — случайный, сохраняется в data/dash_password.txt
DASH_PASSWORD=

# --- Локальная нейросеть (OpenAI-совместимый API) ---
# Ollama: http://127.0.0.1:11434/v1 · LM Studio: http://127.0.0.1:1234/v1 · llama-server: http://127.0.0.1:8080/v1
LLM_URL=http://localhost:1234/v1
# Имя модели. Пусто — взять первую модель, которую отдаёт сервер
LLM_MODEL=
# В демо-режиме ответы модели записаны заранее. 1 — использовать настоящую модель по LLM_URL
DEMO_REAL_LLM=0
# Токен API LM Studio — нужен только для «досье товара» (поиск в интернете через MCP)
LM_API_TOKEN=

# --- Telegram-уведомления (только реальный режим) ---
# Токен бота от @BotFather, например 123456789:AAxxxxxxxx — НИКОГДА не публикуйте его
TG_TOKEN=
# Ваш chat_id (число, его покажет @userinfobot)
TG_CHAT_ID=
# Прокси для api.telegram.org, если напрямую не открывается, например http://127.0.0.1:10809
TG_PROXY=

# --- Браузер (только реальный режим) ---
# Путь к своему Chrome/Chromium. Пусто — браузер, который ставит Playwright
BROWSER_PATH=
# 1 — без окна браузера (капчу тогда не пройти руками)
HEADLESS=0

# --- Файлы ---
# Где хранить базы, кэш фото и профиль браузера с сессией Авито. Пусто — папка data/ рядом с программой
DATA_DIR=
# Папка для экспорта заметок в .md (например, хранилище Obsidian). Пусто — не писать
OBSIDIAN_DIR=
